# ---------- Personal data: NEVER commit ----------
# PST files (real mailbox content) and the search index DB stay on the user's
# machine. Real-mailbox PSTs are excluded by default.
*.pst
*.ost
*.db
*.db-shm
*.db-wal
# Exception: the committed integration-test fixture. This is a slice of the
# public-record Enron corpus (FERC release — no PII), safe to redistribute.
!tests/fixtures/*.pst

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Virtual environments
.venv/
venv/
env/
.env

# Distribution / build
build/
dist/
*.spec.bak

# ---------- Node ----------
# We commit package.json and package-lock.json so installs are reproducible,
# but node_modules is large and platform-specific.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- IDEs / editors ----------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# ---------- OS junk ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Local development scratch ----------
# Diagnostic scripts created during PST format reverse-engineering live here
# and aren't part of the shipped package.
pst_node_probe/
diagnose_pst.py
probe_pypff.py
scratch_*.py
sample_body.py
check_db.py
body_stats.py

# Output captured from background processes
*.ndjson

# Claude harness internal state
.claude/
